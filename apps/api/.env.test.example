# Used only by `pnpm test:integration` (apps/api/test/*.integration-spec.ts). Points at a
# separate database so integration runs never touch dev data — `prisma migrate deploy` against
# this URL creates the database on first run if it doesn't exist yet.
DATABASE_URL="postgresql://aquai:aquai@localhost:5432/aquai_test?schema=public"

# Never actually contacted — ClerkAuthGuard's TOKEN_VERIFIER provider is overridden with a fake
# verifier in test/support/test-app.ts, so these values just need to satisfy config validation.
CLERK_SECRET_KEY="sk_test_fake"
CLERK_JWKS_URL="https://example.invalid/.well-known/jwks.json"
CLERK_ISSUER="https://example.invalid"
# The tenant-isolation suite's webhook-signature tests sign payloads with this same secret
# (svix's own well-known example secret), so verification succeeds/fails deterministically.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"

PORT=3001
NODE_ENV=test
CORS_ORIGINS="http://localhost:3000"
