.env*
!.env.example
!**/.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code local settings (machine-specific permissions, not shared project config)
.claude/settings.local.json

# os
.DS_Store
Thumbs.db

# prisma
apps/api/prisma/migrations/dev.db

# testing
coverage/

